#!/usr/bin/env bash
# Yaam Init — scan project README and detect setup info
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_PATH="${1:-.}"

if [ -f "$SCRIPT_DIR/yaam-server.py" ]; then
    SERVER="$SCRIPT_DIR/yaam-server.py"
elif [ -f "/usr/bin/yaam-server" ]; then
    SERVER="/usr/bin/yaam-server"
else
    echo "Error: yaam-server not found" >&2
    exit 1
fi

exec python3 "$SERVER" --project-path "$PROJECT_PATH" --init
